{
  "openapi": "3.0.0",
  "info": {
    "title": "Liminal API Reference",
    "version": "2.0.0",
    "description": "Liminal enterprise digital asset custody, batch transfers, security risk screening, and wallet management API suite."
  },
  "servers": [
    {
      "url": "https://api-sdk.lmnl.dev",
      "description": "Production SDK API Server"
    }
  ],
  "tags": [
    {
      "name": "Transactions",
      "description": "Send many transactions, batch payouts, and threat screening endpoints."
    },
    {
      "name": "Wallets",
      "description": "Vault wallet operations and multi-asset balance retrieval."
    }
  ],
  "paths": {
    "/api/wallet/send-many-transaction": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Create transaction requests",
        "description": "Execute single or multiple asset transfers from a v1 withdrawal wallet to destination address(es). Integrates Cube3 Security Inspector for optional real-time threat screening.",
        "operationId": "sendManyTransaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendManyTransactionRequest"
              },
              "examples": {
                "StandardTransfer": {
                  "summary": "Standard ETH Transfer Request",
                  "value": {
                    "wallet": {
                      "coin": "eth",
                      "walletId": 14999
                    },
                    "transactions": {
                      "recipientsData": {
                        "recipients": [
                          {
                            "address": "0x017208E63ec387461C7e8f20bA9C6F9Dec939cfe",
                            "amount": "0.008"
                          }
                        ],
                        "sequenceId": "08d5893b-0066-4619-b7af-a5bae54205d5"
                      }
                    },
                    "screeningFlag": true,
                    "feeLevel": "market"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction Request Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendManyTransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Field Validation Error or Threat Screening Blocked",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/ErrorResponse" },
                    { "$ref": "#/components/schemas/ThreatScreeningErrorResponse" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2/transfers": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Retrieve Transfers Collection",
        "description": "Fetch a paginated collection of historical fund transfers.",
        "operationId": "listTransfersV2",
        "parameters": [
          { "name": "wallet_id", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "List of transfers retrieved successfully"
          }
        }
      }
    },
    "/v2/transfers/{tx_id}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Retrieve Single Transfer",
        "description": "Fetch details of a single transfer by transaction hash or ID.",
        "operationId": "getTransferV2",
        "parameters": [
          { "name": "tx_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Transfer details retrieved"
          }
        }
      }
    },
    "/v2/transfers/batch": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Create Batch Transfer",
        "description": "Execute an atomic batch transfer with optional threat screening and idempotency guarantees.",
        "operationId": "createBatchTransferV2",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "wallet_id": "vlt_14999",
                "asset": "ETH",
                "screening_flag": true,
                "recipients": [
                  { "destination_address": "0x71C7656EC7ab88b098defB751B7401B5f6d8976F", "amount": "1.500000" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Batch transfer created successfully",
            "content": {
              "application/json": {
                "example": {
                  "id": "btx_89123049123",
                  "object": "transfer_batch",
                  "wallet_id": "vlt_14999",
                  "status": "PROCESSING",
                  "screening": {
                    "enabled": true,
                    "result": "passed",
                    "screening_id": 14823
                  },
                  "total_amount": "1.500000",
                  "asset": "ETH",
                  "recipient_count": 1,
                  "created_at": "2026-09-10T14:25:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Threat Screening Blocked or Bad Request"
          }
        }
      }
    },
    "/v2/wallets/{wallet_id}/balances": {
      "get": {
        "tags": ["Wallets"],
        "summary": "Retrieve Wallet Balances",
        "description": "Fetch multi-asset liquid, staked, and pending balances for a specific vault wallet resource.",
        "operationId": "getWalletBalancesV2",
        "parameters": [
          {
            "name": "wallet_id",
            "in": "path",
            "required": true,
            "description": "Unique vault wallet ID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet balances fetched successfully",
            "content": {
              "application/json": {
                "example": {
                  "object": "wallet_balance",
                  "wallet_id": "vlt_14999",
                  "vault_name": "Primary Hot Exchange Vault",
                  "balances": [
                    {
                      "asset": "ETH",
                      "coin": "eth",
                      "chain": "ETH",
                      "symbol": "ETH",
                      "total_balance": "150.750000",
                      "available_balance": "148.500000",
                      "staked_balance": "0.000000",
                      "pending_withdrawals": "2.250000"
                    },
                    {
                      "asset": "SOL",
                      "coin": "sol",
                      "chain": "SOL",
                      "symbol": "SOL",
                      "total_balance": "10500.000000",
                      "available_balance": "500.000000",
                      "staked_balance": "10000.000000",
                      "pending_withdrawals": "0.000000"
                    }
                  ],
                  "updated_at": "2026-09-10T14:26:10Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SendManyTransactionRequest": {
        "type": "object",
        "required": ["wallet", "transactions"],
        "properties": {
          "wallet": {
            "type": "object",
            "required": ["coin", "walletId"],
            "properties": {
              "coin": { "type": "string", "example": "eth" },
              "walletId": { "type": "integer", "example": 14999 },
              "transactionType": { "type": "string", "enum": ["transfer", "enableToken"], "default": "transfer" },
              "allToken": { "type": "boolean", "default": false }
            }
          },
          "transactions": {
            "type": "object",
            "required": ["recipientsData"],
            "properties": {
              "recipientsData": {
                "type": "object",
                "required": ["recipients", "sequenceId"],
                "properties": {
                  "recipients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["address", "amount"],
                      "properties": {
                        "address": { "type": "string", "example": "0x017208E63ec387461C7e8f20bA9C6F9Dec939cfe" },
                        "amount": { "type": "string", "example": "0.008" }
                      }
                    }
                  },
                  "sequenceId": { "type": "string", "example": "08d5893b-0066-4619-b7af-a5bae54205d5" }
                }
              }
            }
          },
          "screeningFlag": { "type": "boolean", "default": false },
          "feeLevel": { "type": "string", "enum": ["slow", "market", "aggressive", "custom"] }
        }
      },
      "SendManyTransactionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "properties": {
              "transactionSequenceId": { "type": "integer", "example": 597856 },
              "sequenceId": { "type": "string", "example": "124056b0-fba1-42dc-9595-012537de5ba3" },
              "status": { "type": "integer", "example": 1 },
              "screeningResult": { "type": "string", "example": "passed" },
              "screeningID": { "type": "integer", "example": 14823 }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Validation failure" }
        }
      },
      "ThreatScreeningErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "data": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": { "type": "string", "example": "" },
                    "destinationAddress": { "type": "string", "example": "0xB9dF6D174d6f1f3A61484762E7131F46Ec85b0d1" },
                    "screeningResult": { "type": "string", "example": "blocked" },
                    "screeningID": { "type": "integer", "example": 14825 },
                    "riskScore": { "type": "string", "example": "89" },
                    "msg": { "type": "string", "example": "This transaction has been blocked because the destination addresses in the set of addresses is tagged as a sanctioned address or has participated in malicious activities such as hacks and scams in the past" },
                    "param": { "type": "string", "example": "recipientsData.recipients[2].address" },
                    "location": { "type": "string", "example": "body" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
